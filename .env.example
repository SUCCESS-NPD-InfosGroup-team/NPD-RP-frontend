# Copy to .env.local to override. The defaults in src/auth/keycloak.ts already
# match the local docker-compose of the infra repo.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=npd
VITE_KEYCLOAK_CLIENT_ID=npd-frontend
# Temporary SCRUM-122 mock; keep false until SCRUM-121 API is available.
VITE_USE_MOCK_API=false
